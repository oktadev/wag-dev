# ---- app (Next.js) ----
# Where the auth server is. On Vercel Services this is injected by the binding.
AS_URL=http://localhost:4100
# Shared secret for the auth server's internal endpoints. Server-side only; never prefix with NEXT_PUBLIC_.
INTERNAL_TOKEN=
# Public https address of the auth server, shown in generated cURL/JS/Python snippets (build-time).
NEXT_PUBLIC_AS_URL=http://localhost:4100

# ---- auth server ----
# Generate the four secrets below with: pnpm --filter @wag/auth-server keys
NODE_ENV=production
PORT=4100
ISSUER=https://as.example.com           # public https URL, no path. This is the `aud` the mock WIdP signs.
REDIS_URL=redis://...                   # required in production; holds tokens, replay state, modes, logs
WIDP_PRIVATE_JWK=                       # the mock Workload Identity Provider's signing key
PROVIDER_JWKS=                          # the AS's own token-signing keys
COOKIE_KEYS=                            # comma-separated
# INTERNAL_TOKEN (above) must be identical on both sides.
# Optional:
# TRUST_PROXY=1                         # behind a proxy that sets x-forwarded-for (rate limiting keys on it)
# RATE_LIMIT_PER_MIN=120
# LOG_LEVEL=info
# ALLOW_MEMORY_STORE=1                  # single-instance demo only; state is lost on restart
# ALLOW_INSECURE_REDIS=1                # permit plaintext redis:// in production (private network only)
