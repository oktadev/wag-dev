{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "app/",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "auth-server",
          "format": "url",
          "env": "AS_URL"
        }
      ]
    },
    "auth-server": {
      "root": "auth-server/",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    {
      "source": "/token",
      "destination": {
        "service": "auth-server"
      }
    },
    {
      "source": "/jwks",
      "destination": {
        "service": "auth-server"
      }
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": {
        "service": "auth-server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
